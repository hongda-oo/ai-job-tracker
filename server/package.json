    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.4.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "prisma": "^5.22.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/cors": "^2.8.17",
    "@types/cookie-parser": "^1.4.8",
    "eslint": "^9.16.0",
