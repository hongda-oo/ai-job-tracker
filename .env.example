# This file documents all environment variables used across the monorepo.
# Actual values are read from server/.env and client/.env — copy this into
# each of those and fill in real values for local development.

# --- Server (server/.env) ---
DATABASE_URL=postgresql://user:password@localhost:5432/ai_job_tracker
JWT_SECRET=
JWT_REFRESH_SECRET=
AI_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLIENT_URL=http://localhost:5173
PORT=4000
NODE_ENV=development

# --- Client (client/.env) ---
VITE_API_URL=http://localhost:4000/api/v1
